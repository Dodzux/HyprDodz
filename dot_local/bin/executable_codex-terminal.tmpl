#!/bin/sh
# Open Codex in its own window. An explicit first folder overrides the default.
set -eu

if [ "$#" -gt 0 ] && [ -d "$1" ]; then
    cd -- "$1"
    shift
else
    mkdir -p -- "$HOME/Codex"
    cd -- "$HOME/Codex"
fi

if [ "$#" -eq 0 ]; then
    set -- resume --last --all --cd "$PWD"
fi

exec /usr/bin/kitty --detach --class=codex --title=Codex \
    --working-directory="$PWD" \
    "$HOME/.local/bin/codex-accent" "$HOME/.local/bin/codex" "$@"
