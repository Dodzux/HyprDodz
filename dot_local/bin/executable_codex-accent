#!/usr/bin/env python3
"""Sync the Desktop Accent Codex theme to the desktop palette.

Code roles use coordinated, readable accent colors. The footer directory uses a fixed
color; native text and redraw boundaries remain intact. No polling or background service.
"""
import errno
import fcntl
import os
import pty
import re
import select
import signal
import sys
import termios
import tty

SGR = re.compile(rb'\x1b\[([0-9;:]*)m')
PARTIAL = re.compile(rb'\x1b(?:\[[0-9;:]*)?$')
# Map the native cwd colors; never inject styles into rendered text.
# Native incremental redraws may output only one changed letter at a time.
FIXED_COLORS = {(207, 250, 120): (90, 115, 157),
                (154, 198, 195): (90, 115, 157)}
# Native custom theme colors -> wallpaper palette entries.
COLOR_SLOTS = {(99, 168, 248): 4, (254, 254, 192): 17, (220, 169, 201): 17, (181, 140, 230): 16, (208, 182, 237): 17, (159, 187, 229): 18, (226, 166, 203): 19, (239, 178, 142): 20, (149, 200, 197): 21}


def foreground(rgb):
    if rgb in FIXED_COLORS:
        return b'38;2;' + b';'.join(str(channel).encode() for channel in FIXED_COLORS[rgb])
    if rgb in COLOR_SLOTS:
        return b'38;5;' + str(COLOR_SLOTS[rgb]).encode()
    return None


def replace_sgr(match):
    parts = match[1].split(b';')
    output = []
    index = 0
    while index < len(parts):
        code = parts[index]
        if code in (b'38', b'48', b'58') and index + 1 < len(parts):
            mode = parts[index + 1]
            width = 5 if mode == b'2' else 3 if mode == b'5' else 1
            color = parts[index:index + width]
            replacement = foreground(tuple(map(int, color[2:]))) if code == b'38' and len(color) == 5 and mode == b'2' and all(x.isdigit() for x in color[2:]) else None
            output.extend(replacement.split(b';') if replacement else color)
            index += width
        else:
            channels = code.split(b':')
            replacement = foreground(tuple(map(int, channels[-3:]))) if channels[:2] == [b'38', b'2'] and len(channels) in (5, 6) and all(x.isdigit() for x in channels[-3:]) else None
            output.append(replacement.replace(b';', b':') if replacement else code)
            index += 1
    return b'\x1b[' + b';'.join(output) + b'm'


class Filter:
    def __init__(self):
        self.pending = b''

    def feed(self, data, final=False):
        data = self.pending + data
        self.pending = b''
        partial = PARTIAL.search(data) if not final else None
        hold = len(partial[0]) if partial and len(partial[0]) <= 256 else 0
        if hold:
            self.pending, data = data[-hold:], data[:-hold]
        return SGR.sub(replace_sgr, data)


def write_all(fd, data):
    while data:
        try:
            count = os.write(fd, data)
        except InterruptedError:
            continue
        data = data[count:]


def main():
    command = sys.argv[1:]
    if not command:
        raise SystemExit('Usage: codex-accent COMMAND [ARGUMENTS...]')
    if not (os.isatty(0) and os.isatty(1)):
        os.execvp(command[0], command)
    attributes = termios.tcgetattr(0)
    size = fcntl.ioctl(0, termios.TIOCGWINSZ, b'\0' * 8)
    pid, master = pty.fork()
    if pid == 0:
        termios.tcsetattr(0, termios.TCSANOW, attributes)
        fcntl.ioctl(0, termios.TIOCSWINSZ, size)
        try:
            os.execvp(command[0], command)
        except OSError as error:
            print(f'codex-accent: {error}', file=sys.stderr)
            os._exit(127)

    def resize(signum, frame):
        try:
            fcntl.ioctl(master, termios.TIOCSWINSZ, fcntl.ioctl(0, termios.TIOCGWINSZ, b'\0' * 8))
        except OSError:
            pass

    def forward(signum, frame):
        try:
            os.killpg(pid, signum)
        except ProcessLookupError:
            pass

    signal.signal(signal.SIGWINCH, resize)
    for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(signum, forward)
    output = Filter()
    try:
        tty.setraw(0)
        inputs = [0, master]
        while True:
            ready, _, _ = select.select(inputs, [], [])
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError as error:
                    if error.errno != errno.EIO:
                        raise
                    data = b''
                if not data:
                    write_all(1, output.feed(b'', final=True))
                    break
                write_all(1, output.feed(data))
            if 0 in ready:
                data = os.read(0, 65536)
                if not data:
                    inputs.remove(0)
                    forward(signal.SIGHUP, None)
                else:
                    try:
                        write_all(master, data)
                    except OSError as error:
                        if error.errno != errno.EIO:
                            raise
    finally:
        termios.tcsetattr(0, termios.TCSADRAIN, attributes)
        os.close(master)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


if __name__ == '__main__':
    raise SystemExit(main())
