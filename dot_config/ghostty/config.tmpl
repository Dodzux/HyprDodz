# =============================================================================
# Ghostty Configuration — HyprBlur
# =============================================================================
# Ported from Kitty to preserve the exact look and feel.
# =============================================================================

# -----------------------------------------------------------------------------
# Typography
# -----------------------------------------------------------------------------

font-family = CaskaydiaCove Nerd Font
font-style = Regular
font-style-italic = Italic
font-size = 13
# Match Kitty's 108% line height.
adjust-cell-height = 8%

# -----------------------------------------------------------------------------
# Colors — HyprBlur
# -----------------------------------------------------------------------------

foreground = #e0e4ea
background = #111111
# Match Kitty: compositor supplies 70% window opacity and desktop blur.
background-opacity = 1
gtk-custom-css = blur.css
selection-foreground = #{{ template "accent_fg" . }}
selection-background = #{{ template "accent" . }}

cursor-color = #{{ template "accent" . }}
cursor-text = #{{ template "accent_fg" . }}
cursor-style = bar
# One additional pixel brings the beam closer to Kitty's 1.8pt cursor.
adjust-cursor-thickness = 1
cursor-style-blink = true

# The 16 terminal colors (muted/desaturated palette)

# Black / Charcoal
palette = 0=#1b1e24
palette = 8=#606878
# Red (Muted)
palette = 1=#df8290
palette = 9=#f09ba7
# Green (Muted)
palette = 2=#9bc9ad
palette = 10=#b5ddc3
# Yellow (Muted)
palette = 3=#dfbd94
palette = 11=#edd0ae
# Blue (Muted)
palette = 4=#{{ template "accent" . }}
palette = 12=#{{ template "accent" . }}

# Magenta (Muted)
palette = 5=#b6a5d9
palette = 13=#cbbce8
# Cyan (Muted)
palette = 6=#90caca
palette = 14=#b0dede
# Same desktop-derived extended colors as Kitty.
{{- $accent := includeTemplate "accent" . -}}
{{- $script := joinPath .chezmoi.sourceDir "dot_config/hypr/scripts/executable_sync_border.py" -}}
{{- $palette := (output "python3" "-B" "-c" "import json,runpy,sys; print(json.dumps(runpy.run_path(sys.argv[1])['codex_palette'](sys.argv[2])))" $script $accent) | fromJson }}
palette = 16=#{{ index $palette "16" }}
palette = 17=#{{ index $palette "17" }}
palette = 18=#{{ index $palette "18" }}
palette = 19=#{{ index $palette "19" }}
palette = 20=#{{ index $palette "20" }}
palette = 21=#{{ index $palette "21" }}

# White (Platinum)
palette = 7=#d6dce5
palette = 15=#f1f3f6
# -----------------------------------------------------------------------------
# Window & Chrome
# -----------------------------------------------------------------------------

# Same point units and values as Kitty's window_padding_width 18 22.
window-padding-x = 22
window-padding-y = 18
# Match Kitty's centered placement of leftover cell space.
window-padding-balance = equal
window-padding-color = background
window-theme = dark
window-decoration = none
gtk-titlebar = false
gtk-tabs-location = top

# -----------------------------------------------------------------------------
# Shell Integration
# -----------------------------------------------------------------------------

command = direct:/usr/bin/fish
shell-integration = fish
shell-integration-features = cursor,sudo,title

# -----------------------------------------------------------------------------
# Behavior
# -----------------------------------------------------------------------------

mouse-hide-while-typing = true
confirm-close-surface = true
# Wallpaper syncing reloads colors quietly; keep clipboard toasts.
app-notifications = no-config-reload
quit-after-last-window-closed = true
# Reuse the existing GTK process when reopening the terminal soon afterward.
quit-after-last-window-closed-delay = 30s
clipboard-read = allow
clipboard-write = allow
scrollback-limit-bytes = 10000000

# -----------------------------------------------------------------------------
# Rendering
# -----------------------------------------------------------------------------

# Native rendering; cursor effects are configured only with explicit approval.

# Reuse the app process for subsequent windows and tabs.
gtk-single-instance = true

# Approved cursor-only trail; animate only while this terminal has focus.
custom-shader = shaders/cursor_subtle.glsl
custom-shader-animation = true
