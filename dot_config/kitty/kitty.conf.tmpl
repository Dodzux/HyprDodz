# vim:ft=kitty

## name:     HyprBlur
## author:   User
## license:  MIT
## blurb:    Elegant monochrome for the modern minimalist.

# -----------------------------------------------------------------------------
# Core Typographic Engine
# -----------------------------------------------------------------------------

font_family      CaskaydiaCove Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 13
window_padding_width 18 22

# -----------------------------------------------------------------------------
# Rendering Tweaks
# -----------------------------------------------------------------------------

text_composition_strategy platform
disable_ligatures never
adjust_line_height 108%
adjust_column_width 100%
box_drawing_scale 0.001, 1, 1.5, 2

# -----------------------------------------------------------------------------
# Theme Colors (HyprBlur)
# -----------------------------------------------------------------------------

foreground #e0e4ea
background #111111
selection_foreground #{{ template "accent_fg" . }}
selection_background #{{ template "accent" . }}

# Cursor colors (`cursor` is the wallpaper accent, rewritten by
# ~/.config/hypr/scripts/sync_border.py; kitty auto-reloads)
cursor #{{ template "accent" . }}
cursor_text_color #111111

# Scrollbar colors
scrollbar_handle_color  #888888
scrollbar_track_color   #1c1c1c

# URL color when hovering
url_color #{{ template "accent" . }}

# Kitty window border colors
active_border_color     #e5e5e5
inactive_border_color   #1c1c1c
bell_border_color       #555555

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors (Platinum active, Onyx inactive)
active_tab_foreground #{{ template "accent" . }}
active_tab_background #111111
inactive_tab_foreground #697485
inactive_tab_background #111111
tab_bar_background #111111

# Colors for marks
mark1_foreground #111111
mark1_background #e5e5e5
mark2_foreground #111111
mark2_background #888888
mark3_foreground #111111
mark3_background #444444

# -----------------------------------------------------------------------------
# The 16 Terminal Colors (Muted/Desaturated)
# -----------------------------------------------------------------------------

# Black / Charcoal
color0 #1b1e24
color8 #606878

# Red (Muted)
color1 #df8290
color9 #f09ba7

# Green (Muted)
color2 #9bc9ad
color10 #b5ddc3

# Yellow (Muted)
color3 #dfbd94
color11 #edd0ae

# Blue: desktop accent for Codex UI highlights
color4 #{{ template "accent" . }}
color12 #{{ template "accent" . }}

# Magenta (Muted)
color5 #b6a5d9
color13 #cbbce8

# Cyan (Muted)
color6 #90caca
color14 #b0dede

# Desktop Accent: keywords, variables, functions, types, numbers, strings.
{{- $accent := includeTemplate "accent" . -}}
{{- $script := joinPath .chezmoi.sourceDir "dot_config/hypr/scripts/executable_sync_border.py" -}}
{{- $palette := (output "python3" "-B" "-c" "import json,runpy,sys; print(json.dumps(runpy.run_path(sys.argv[1])['codex_palette'](sys.argv[2])))" $script $accent) | fromJson }}
color16 #{{ index $palette "16" }}
color17 #{{ index $palette "17" }}
color18 #{{ index $palette "18" }}
color19 #{{ index $palette "19" }}
color20 #{{ index $palette "20" }}
color21 #{{ index $palette "21" }}

# White (Platinum)
color7 #d6dce5
color15 #f1f3f6

# Visual Cursor Trail (from old config)
cursor_trail 1

# Terminal Sound Effects:
# The sound play commands are triggered in ~/.config/fish/config.fish:
# - Startup (Kiss): ~/.config/kitty/Kiss.m4a
# - Shutdown (WinXP): ~/.config/kitty/windows-xp-shutdown.mp3

# -----------------------------------------------------------------------------
# Key Mappings (Ghostty-like Word Navigation)
# -----------------------------------------------------------------------------

# Make ctrl+backspace delete a single path component (acts like Alt+Backspace)
map ctrl+backspace send_text all \x1b\x7f

# Make ctrl+left move by path components (acts like Alt+Left)
map ctrl+left send_text all \x1bb

# Approved terminal style: spacing, cursor and quiet tabs.
background_opacity 1
cursor_shape beam
cursor_beam_thickness 1.8
cursor_blink_interval 0.55
cursor_trail_decay 0.08 0.18
cursor_trail_start_threshold 2
shell_integration no-cursor
enable_audio_bell no
visual_bell_duration 0
hide_window_decorations yes
tab_bar_edge bottom
tab_bar_style separator
tab_separator "   "
tab_bar_align left
tab_bar_min_tabs 2
tab_bar_margin_height 4 6
tab_title_template " {index}  {title} "
active_tab_font_style bold
startup_session ~/.config/kitty/launch.kitty-session
