# Hyprlock — HyprBlur Theme
# Ported from old catppuccin config with monochrome color palette
# See: https://wiki.hypr.land/Hypr-Ecosystem/hyprlock/

# ▓▒░ HYPRBLUR COLOR PALETTE
$base     = rgb(111111)
$mantle   = rgb(1c1c1c)
$surface0 = rgb(2d2d2d)
$text     = rgb(e5e5e5)
$subtext  = rgb(888888)
$accent   = rgb({{ template "accent" . }})
$red      = rgb(d75f5f)
$green    = rgb(a3be8c)

# Hex-only variants for Pango markup (no 0x prefix)
$textAlpha   = e5e5e5
$accentAlpha = {{ template "accent" . }}

$font = CaskaydiaCove Nerd Font Italic

# ▓▒░ GENERAL
# NOTE: no_fade_in, grace, and disable_loading_bar were removed upstream.
#       Grace period is now passed as the --grace CLI flag (see hypridle.conf).
general {
    hide_cursor = false
}

# ▓▒░ BACKGROUND — lightly dim the existing session blur
background {
    monitor     =
    color       = rgba(0,0,0,0.20)
    blur_passes = 0
}

# BEGIN LOCK TRANSITION
# Speeds are in 100ms units: 400ms in, 250ms out.
animations {
    enabled = true
    bezier = lockSmooth, 0.4, 0.0, 0.2, 1.0
    animation = fadeIn, 1, 4, lockSmooth
    animation = fadeOut, 1, 2.5, lockSmooth
}
# END LOCK TRANSITION

# ▓▒░ CLOCK — large time display at top
label {
    monitor     =
    text        = $TIME12
    color       = $text
    font_size   = 90
    font_family = $font
    position    = 0, -400
    halign      = center
    valign      = top
}

# ▓▒░ DATE — below the clock
# Re-read every minute. It used to be every 12h, so a lock that spanned
# midnight kept showing the previous day for up to 12 hours.
label {
    monitor     =
    text        = cmd[update:60000] date +"%A, %d %B %Y"
    color       = $text
    font_size   = 25
    font_family = $font
    position    = 0, -350
    halign      = center
    valign      = top
}

# ▓▒░ KEYBOARD LAYOUT INDICATOR
label {
    monitor     =
    text        = Layout: $LAYOUT
    color       = $subtext
    font_size   = 18
    font_family = $font
    position    = 0, -300
    halign      = center
    valign      = top
}

# ▓▒░ PASSWORD INPUT FIELD
input-field {
    monitor          =
    size             = 300, 60
    outline_thickness = 4
    dots_size        = 0.2
    dots_spacing     = 0.2
    dots_center      = true
    outer_color      = $accent
    inner_color      = $surface0
    font_color       = $text
    fade_on_empty    = true
    placeholder_text = <span foreground="##$textAlpha"><i>󰌾 Logged in as </i><span foreground="##$accentAlpha">{{ .displayName | replace "&" "&amp;" | replace "<" "&lt;" }}</span></span>
    hide_input       = false
    check_color      = $accent
    fail_color       = $red
    fail_text        = <i>$FAIL <b>($ATTEMPTS)</b></i>
    capslock_color   = $green
    position         = 0, -120
    halign           = center
    valign           = center
}

# BEGIN BOTTOM POWER BUTTONS
# Reference-style white icons; dim the icon slightly on hover.

image {
    monitor =
    path = /run/user/{{ .chezmoi.uid }}/hyprlock-buttons/suspend.png
    size = 80
    rounding = 0
    border_size = 0
    position = -128, 16
    halign = center
    valign = bottom
    zindex = 2
    reload_time = 0
    onclick = systemctl suspend
}

image {
    monitor =
    path = /run/user/{{ .chezmoi.uid }}/hyprlock-buttons/restart.png
    size = 80
    rounding = 0
    border_size = 0
    position = 0, 16
    halign = center
    valign = bottom
    zindex = 2
    reload_time = 0
    onclick = systemctl reboot
}

image {
    monitor =
    path = /run/user/{{ .chezmoi.uid }}/hyprlock-buttons/shutdown.png
    size = 80
    rounding = 0
    border_size = 0
    position = 128, 16
    halign = center
    valign = bottom
    zindex = 2
    reload_time = 0
    onclick = systemctl poweroff
}
# END BOTTOM POWER BUTTONS
